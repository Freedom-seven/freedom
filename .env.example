# ─────────────────────────────────────────────────────────────
# Digital-me LIVE mode (OPTIONAL — the site ships complete without these)
# Curated mode is the default and requires zero environment variables.
#
# To enable live LLM answers, set LIVE_MODE=on AND provide a key.
# Keys are read ONLY on the server (src/app/api/ask/route.ts).
# Never commit .env — this file documents the expected shape only.
# ─────────────────────────────────────────────────────────────

# "on" enables the live route; anything else keeps curated-only.
LIVE_MODE=off

# Provider key, server-side only.
ASK_API_KEY=

# Provider adapter to use: "anthropic" | "openai" | "none"
ASK_PROVIDER=none

# Cost/abuse guardrails (server-enforced)
ASK_DAILY_LIMIT=60
ASK_HOURLY_LIMIT=10
ASK_MAX_INPUT_CHARS=500
